{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "June",
  "version": "0.0.0",
  "identifier": "com.juneai.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @june/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @june/web build",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "June",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Productivity",
    "shortDescription": "The personal AI that remembers you.",
    "longDescription": "June is the open personal AI that remembers you. It runs locally via Gemma 4 and optionally reaches the cloud via Gemini, with one persistent memory across every conversation."
  }
}
