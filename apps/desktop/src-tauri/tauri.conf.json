{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "June",
  "version": "0.1.0",
  "identifier": "ai.june.app",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [
      {
        "title": "June",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Your AI, your files.",
    "longDescription": "One app for every model, where you can see and keep everything.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
