{
  "name": "@june/server",
  "private": true,
  "type": "module",
  "description": "The June daemon: HTTP + SSE API on loopback, serving the UI.",
  "bin": {
    "june": "./dist/server.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/server.mjs",
    "dev": "pnpm build && node dist/server.mjs serve --static ../web/build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@june/ui": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
