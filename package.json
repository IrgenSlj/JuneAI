{
  "name": "june",
  "version": "0.1.0",
  "private": true,
  "description": "June AI — the open personal AI that remembers you. JS workspace root.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "./tools/bootstrap.sh",
    "dev": "pnpm --filter @june/web dev",
    "build": "pnpm -r --filter './packages/**' --filter '@june/web' build",
    "check": "pnpm -r --filter './packages/**' --filter '@june/web' check",
    "check:all": "./tools/check.sh",
    "desktop:dev": "pnpm --filter @june/desktop dev",
    "desktop:build": "pnpm --filter @june/desktop build",
    "codegen": "./tools/codegen.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5"
    }
  }
}
