{
  "name": "@june/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Svelte components and typed API client for every June shell.",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./components/*.svelte": "./src/components/*.svelte"
  },
  "files": ["src"],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "codegen": "../../tools/codegen.sh"
  },
  "dependencies": {
    "@june/design": "workspace:*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
