{
  "name": "@june/ui",
  "private": true,
  "type": "module",
  "description": "Svelte components, the typed daemon client and the platform layer.",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": "./src/api/index.ts",
    "./platform": "./src/platform/index.ts",
    "./components/*.svelte": "./src/components/*.svelte"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  }
}
