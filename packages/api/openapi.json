      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ChatEvent": {
        "description": "One item in the SSE stream returned by POST /chat.\n\nThe wire format is one ``data:`` frame per event carrying a JSON\nobject with this shape. ``type`` drives the UI.",
        "properties": {
          "type": {
            "description": "Discriminator that determines the meaning of the payload.",
            "enum": [
              "token",
              "tool_call",
              "tool_result",
              "done",
              "error"
            ],
            "title": "Type",
            "type": "string"
          },
          "content": {
            "default": "",
            "description": "Textual content for token and error events; empty otherwise.",
            "title": "Content",
            "type": "string"
          },
          "tool_name": {
            "default": "",
            "description": "Name of the tool for tool_call and tool_result events.",
            "title": "Tool Name",
            "type": "string"
          },
          "tool_args": {
            "additionalProperties": true,
            "description": "Arguments passed to the tool for tool_call events.",
            "title": "Tool Args",
            "type": "object"
          },
          "tool_result": {
            "default": "",
            "description": "Serialized result returned by the tool for tool_result events.",
            "title": "Tool Result",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "ChatEvent",
        "type": "object"
      }
    }
  }
}
