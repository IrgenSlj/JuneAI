{
  "openapi": "3.1.0",
  "info": {
    "title": "June API",
    "description": "HTTP boundary for the June brain. The canonical client is apps/web (Next.js) but any shell speaking JSON/SSE can use it.",
    "version": "0.2.0"
  },
  "paths": {
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat",
        "description": "Stream June's reply as SSE. Each frame is a JSON-encoded ChatEvent.",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream. See ChatEvent for the frame payload schema.",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/memory/{user_id}": {
      "get": {
        "tags": [
          "memory"
        ],
        "summary": "Get Memory",
        "description": "Return everything June remembers about a user, across all three stores.",
        "operationId": "get_memory_memory__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemorySnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/memory/{user_id}/fact/{ref}": {
      "patch": {
        "tags": [
          "memory"
        ],
        "summary": "Update Memory Fact",
        "description": "Patch a structured fact by ref.\n\nOnly the SQLite ref kinds are supported (``goal:``, ``open_loop:``,\n``calendar:``). Editing semantic facts or graph nodes is not yet\nexposed here; those have their own paths.\n\nThe returned ``ref`` may differ from the request ``ref`` when the\nprimary key changed (a goal renamed, a calendar item rescheduled).\nClients should use the returned ref for any subsequent edit or\ndelete operation on the same fact.",
        "operationId": "update_memory_fact_memory__user_id__fact__ref__patch",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "memory"
        ],
        "summary": "Delete Memory Fact",
        "description": "Remove a fact by its opaque ref.\n\nSupports refs returned from ``GET /memory``:\n  - ``semantic:<fact_id>`` removes a semantic fact from vector + shadow\n  - ``node:<node_id>`` removes a graph entity and its edges\n  - ``edge:<src>|<dst>|<kind>`` removes a single edge\n  - ``goal:<title>`` removes a structured goal\n  - ``open_loop:<topic>`` removes a structured open loop\n  - ``calendar:<title>|<date>|<time>`` removes a structured calendar item\n  - ``journal:<id>`` removes a journal entry\n  - ``body_metric:<date>`` removes a body metric row",
        "operationId": "delete_memory_fact_memory__user_id__fact__ref__delete",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ref"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDeleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Get Settings",
        "description": "Return the current non-secret configuration plus reachability flags.",
        "operationId": "get_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          }
        }
      }
    },
    "/settings/forget-key": {
      "post": {
        "tags": [
          "settings"
        ],
        "summary": "Forget Key",
        "description": "Delete the Gemini key from the OS credential store and the JSON fallback.",
        "operationId": "forget_key_settings_forget_key_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgetKeyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/setup/status": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "Get Setup Status",
        "description": "Report whether the active runtime is ready to serve chat requests.",
        "operationId": "get_setup_status_setup_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/setup/apply": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "Apply Setup",
        "description": "Persist the user's provider choice and verify it with a live round-trip.",
        "operationId": "apply_setup_setup_apply_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupApplyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/skills": {
      "get": {
        "tags": [
          "skills"
        ],
        "summary": "List Skills",
        "description": "List every MCP skill with its current enabled state and tools.",
        "operationId": "list_skills_skills_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/skills/{key}/toggle": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Toggle Skill",
        "description": "Enable or disable a skill.\n\nPersists to ``~/Library/Application Support/June/skills.toml`` and\nrebuilds the agent so the next chat turn picks up the new tool set.",
        "operationId": "toggle_skill_skills__key__toggle_post",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillToggleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillToggleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get System Status",
        "description": "Report which runtime is active and whether it's actually usable.\n\nShells display a small runtime badge built from this payload, so it\nmust be honest about misconfigurations (Ollama not running, Gemma\ntag not pulled, missing API key) instead of pretending everything\nis fine.",
        "operationId": "get_system_status_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Healthz",
        "description": "Liveness probe \u2014 no brain calls, just confirms the process is up.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Stable identifier for the user. Used as the memory partition key."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "The user's message in plain text."
          },
          "skill": {
            "type": "string",
            "title": "Skill",
            "description": "Optional skill hint to guide the agent. Defaults to general assistant behavior.",
            "default": "assistant"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "message"
        ],
        "title": "ChatRequest",
        "description": "A single user turn submitted to POST /chat."
      },
      "ForgetKeyResponse": {
        "properties": {
          "cleared_from": {
            "type": "string",
            "enum": [
              "keyring",
              "file",
              "none"
            ],
            "title": "Cleared From",
            "description": "Where the key actually lived. 'none' means nothing was stored."
          }
        },
        "type": "object",
        "required": [
          "cleared_from"
        ],
        "title": "ForgetKeyResponse",
        "description": "Outcome of POST /settings/forget-key."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryDeleteResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "removed": {
            "type": "boolean",
            "title": "Removed"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "ref",
          "removed"
        ],
        "title": "MemoryDeleteResponse",
        "description": "Result of DELETE /memory/{user_id}/fact/{ref}."
      },
      "MemoryFact": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "Category of fact, e.g. 'goal', 'semantic', 'entity:person'."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short human-readable label.",
            "default": ""
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Longer description or detail, when present.",
            "default": ""
          },
          "ref": {
            "type": "string",
            "title": "Ref",
            "description": "Opaque identifier for delete/edit operations.",
            "default": ""
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Structured fields specific to this fact kind."
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "MemoryFact",
        "description": "One structured row read from memory.\n\n``ref`` is a stable opaque string that DELETE /memory/{user}/fact/{ref}\nunderstands. It carries the source tag (``semantic:``, ``node:``,\n``edge:``, ``goal:``\u2026) so the API can route the delete to the right\nstore without a second schema lookup."
      },
      "MemorySnapshot": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Goals"
          },
          "open_loops": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Open Loops"
          },
          "calendar": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Calendar"
          },
          "journal": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Journal",
            "description": "Recent journal entries written by the user or by the daily skill."
          },
          "body_metrics": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Body Metrics",
            "description": "Body metrics recorded by the health skill (one row per day)."
          },
          "semantic_facts": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Semantic Facts",
            "description": "Facts extracted from conversation and embedded for semantic recall."
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/MemoryFact"
            },
            "type": "array",
            "title": "Entities",
            "description": "People, places, projects and concepts June has mapped for this user."
          },
          "recent_messages": {
            "type": "integer",
            "title": "Recent Messages",
            "description": "Chat messages stored for this user.",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "MemorySnapshot",
        "description": "Summary of what June remembers about a user.\n\nThe SQLite structured tables, the vector semantic store, and the\nknowledge graph are all represented. UI can show them grouped or\nmerged in a timeline."
      },
      "MemoryUpdateRequest": {
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Fields",
            "description": "Map of field name to new value. Unset fields keep current values."
          }
        },
        "type": "object",
        "title": "MemoryUpdateRequest",
        "description": "Body of PATCH /memory/{user_id}/fact/{ref}.\n\nAll fields are optional strings; missing keys preserve current values.\nThe set of accepted keys depends on the ref kind:\n  - goal: title, category, target_date, next_step, status\n  - open_loop: topic, next_step, due_date, status\n  - calendar: title, date, time, details, status, source"
      },
      "MemoryUpdateResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "updated": {
            "type": "boolean",
            "title": "Updated"
          },
          "fact": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemoryFact"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "ref",
          "updated"
        ],
        "title": "MemoryUpdateResponse",
        "description": "Result of PATCH /memory/{user_id}/fact/{ref}.\n\n``ref`` may be a *new* opaque identifier when the primary key changed\n(e.g. a goal renamed). Clients should use the returned ref for any\nsubsequent edit/delete on this fact."
      },
      "SettingsView": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Active preset key ('gemma' or 'gemini')."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Active model identifier."
          },
          "gemma_model": {
            "type": "string",
            "title": "Gemma Model",
            "description": "Persisted Gemma tag override, if any.",
            "default": ""
          },
          "gemini_model": {
            "type": "string",
            "title": "Gemini Model",
            "description": "Persisted Gemini model override, if any.",
            "default": ""
          },
          "ollama_base_url": {
            "type": "string",
            "title": "Ollama Base Url",
            "description": "Override for the Ollama endpoint, if any.",
            "default": ""
          },
          "ollama_reachable": {
            "type": "boolean",
            "title": "Ollama Reachable",
            "description": "Gemma preset only.",
            "default": false
          },
          "ollama_has_model": {
            "type": "boolean",
            "title": "Ollama Has Model",
            "description": "Gemma preset only.",
            "default": false
          },
          "api_key_present": {
            "type": "boolean",
            "title": "Api Key Present",
            "description": "Gemini preset only.",
            "default": false
          },
          "key_storage": {
            "type": "string",
            "enum": [
              "keyring",
              "file",
              "none"
            ],
            "title": "Key Storage",
            "description": "Where the Gemini key is stored. 'keyring' means the OS credential store, 'file' means the 0600 config.json fallback, 'none' means no key is set."
          },
          "key_storage_label": {
            "type": "string",
            "title": "Key Storage Label",
            "description": "Human-readable storage label for the settings UI."
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "key_storage",
          "key_storage_label"
        ],
        "title": "SettingsView",
        "description": "Non-secret snapshot of the active configuration."
      },
      "SetupApplyRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "gemma",
              "gemini"
            ],
            "title": "Provider",
            "description": "Which runtime to activate."
          },
          "gemini_api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemini Api Key",
            "description": "Required when provider is 'gemini'. Stored in config.json with mode 0600 until native credential storage lands."
          },
          "gemma_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemma Model",
            "description": "Ollama tag override. Defaults to the preset's default (gemma4:e4b)."
          },
          "gemini_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemini Model",
            "description": "Gemini model override. Defaults to gemini-2.0-flash."
          }
        },
        "type": "object",
        "required": [
          "provider"
        ],
        "title": "SetupApplyRequest",
        "description": "User's provider pick from the /setup screen."
      },
      "SetupApplyResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "description": "True when the chosen provider successfully produced a token."
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "The preset that was applied."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The model the provider is configured to use."
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "description": "True when a one-shot request to the provider returned a response."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Short, human-readable status. Empty on clean success.",
            "default": ""
          },
          "hint": {
            "type": "string",
            "title": "Hint",
            "description": "When ok is false, a specific actionable hint (e.g. 'Ollama not running').",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "ok",
          "provider",
          "model",
          "verified"
        ],
        "title": "SetupApplyResponse",
        "description": "Result of a setup attempt, including a verification round-trip."
      },
      "SetupStatus": {
        "properties": {
          "is_configured": {
            "type": "boolean",
            "title": "Is Configured",
            "description": "True once the active provider has everything it needs to run: Ollama reachable with the Gemma tag pulled, or a Gemini API key present."
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Active preset key ('gemma' or 'gemini'), or empty when no choice has been persisted.",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Active model identifier, if any.",
            "default": ""
          },
          "ollama_reachable": {
            "type": "boolean",
            "title": "Ollama Reachable",
            "description": "Gemma preset only.",
            "default": false
          },
          "ollama_has_model": {
            "type": "boolean",
            "title": "Ollama Has Model",
            "description": "Gemma preset only.",
            "default": false
          },
          "api_key_present": {
            "type": "boolean",
            "title": "Api Key Present",
            "description": "Gemini preset only.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "is_configured"
        ],
        "title": "SetupStatus",
        "description": "Snapshot used by the UI to decide whether to show /setup or /chat."
      },
      "SkillInfo": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Stable skill id, e.g. 'calendar' or 'research'."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "What the skill does.",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Manifest toggle state.",
            "default": true
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Lifecycle state: stopped, starting, running, crashed, or disabled.",
            "default": "stopped"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Last error message when status is 'crashed', empty otherwise.",
            "default": ""
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/SkillToolInfo"
            },
            "type": "array",
            "title": "Tools",
            "description": "Tools this skill contributes to the agent when running."
          }
        },
        "type": "object",
        "required": [
          "key"
        ],
        "title": "SkillInfo",
        "description": "One MCP skill server with its current lifecycle state."
      },
      "SkillToggleRequest": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "New enabled state."
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "SkillToggleRequest",
        "description": "POST /skills/{key}/toggle body."
      },
      "SkillToggleResponse": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "key",
          "enabled",
          "status"
        ],
        "title": "SkillToggleResponse",
        "description": "Result of a toggle \u2014 callers refresh their UI from this."
      },
      "SkillToolInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Tool identifier the agent uses to call it."
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human-readable description.",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "SkillToolInfo",
        "description": "A single tool inside a skill \u2014 shown under the skill in the UI."
      },
      "SkillsResponse": {
        "properties": {
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillInfo"
            },
            "type": "array",
            "title": "Skills"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          }
        },
        "type": "object",
        "title": "SkillsResponse",
        "description": "GET /skills payload."
      },
      "SystemStatus": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Active preset key: 'gemma' or 'gemini'."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Human-readable runtime label."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Active model identifier."
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "'local' when inference stays on-device, 'api' otherwise."
          },
          "privacy_label": {
            "type": "string",
            "title": "Privacy Label",
            "description": "'local-only' or 'api-assisted'."
          },
          "base_url": {
            "type": "string",
            "title": "Base Url",
            "description": "Endpoint the brain is talking to.",
            "default": ""
          },
          "ollama_reachable": {
            "type": "boolean",
            "title": "Ollama Reachable",
            "description": "True when the configured Ollama instance responds. Only meaningful for the gemma preset.",
            "default": false
          },
          "ollama_has_model": {
            "type": "boolean",
            "title": "Ollama Has Model",
            "description": "True when the active Gemma tag is already pulled. Only meaningful for the gemma preset.",
            "default": false
          },
          "api_key_present": {
            "type": "boolean",
            "title": "Api Key Present",
            "description": "True when the active runtime has the credentials it needs. Only meaningful for the gemini preset.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "provider",
          "label",
          "model",
          "mode",
          "privacy_label"
