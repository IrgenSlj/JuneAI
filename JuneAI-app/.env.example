# Runtime preset:
# - local_gemma_4      -> main local model, native tools, best local default
# - local_mistral_3b   -> smaller local model, strict one-tool-at-a-time behavior
# - local_mistral_8b   -> preferred local model for better tool reliability
# - claude_high        -> best cloud quality, Anthropic API required
MODEL_PRESET=local_gemma_4

# Local model defaults. Point these at the actual model tags installed in Ollama or
# any OpenAI-compatible local server you use.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LOCAL_SMALL_MODEL_NAME=mistral
LOCAL_LARGE_MODEL_NAME=mistral-nemo
LOCAL_GEMMA_MODEL_NAME=gemma4
MODEL_NAME=

# Claude fallback / high-performance profile
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-3-5-sonnet-latest

# Optional tuning overrides
MODEL_TEMPERATURE=
MODEL_MAX_TOKENS=
MODEL_TOOL_STRATEGY=

# Where conversation memory is stored locally
MEMORY_DIR=.june_memory
