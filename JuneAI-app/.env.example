# Core runtime
MODEL_PRESET=local_gemma_4
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MEMORY_DIR=.june_memory

# Optional advanced runtime overrides
MODEL_PROVIDER=
MODEL_NAME=
MODEL_TEMPERATURE=
MODEL_MAX_TOKENS=
MODEL_TOOL_STRATEGY=

# Optional model tag overrides
# Leave these blank unless you explicitly want to override preset defaults.
LOCAL_LLAMA_MODEL_NAME=llama3.2:3b
LOCAL_SMALL_MODEL_NAME=mistral
LOCAL_LARGE_MODEL_NAME=
LOCAL_GEMMA_MODEL_NAME=gemma4:e4b
CLAUDE_MODEL_NAME=

# API-assisted runtime
ANTHROPIC_API_KEY=

# Notes
# - LOCAL_LARGE_MODEL_NAME is shared by local_mistral_7b and local_mistral_8b.
# - make check-ollama should be run after changing local runtime settings.
