# June v2 environment. Only two runtime profiles are supported (ADR 0002):
#   MODEL_PROVIDER=gemma  -> local Gemma 4 via Ollama (default)
#   MODEL_PROVIDER=gemini -> cloud Gemini via Google AI Studio

# --- Local inference (default) ----------------------------------------------
MODEL_PROVIDER=gemma
GEMMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cloud escape valve -----------------------------------------------------
# Uncomment and fill to enable Gemini. Get a key at https://aistudio.google.com
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Optional overrides -----------------------------------------------------
# MODEL_TEMPERATURE=0.4
# MODEL_MAX_TOKENS=4096
# JUNE_DATA_DIR=        # defaults to the platform app-data dir (see docs/setup/environment.md)
